---
import Page from "./Page.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const localizePath = useTranslatedPath(lang);
const labels = {
  es: { home: "Inicio", updated: "Última actualización" },
  ca: { home: "Inici", updated: "Última actualització" },
  en: { home: "Home", updated: "Last updated" },
}[lang];
---

<Page title={`${title} | Grúas del Vallès`} description={description}>
  <section class="border-b border-muted/40 bg-surface-alt">
    <div class="container-narrow py-12 lg:py-16">
      <Breadcrumb
        items={[
          { label: labels.home, href: localizePath("/") },
          { label: title },
        ]}
        class="mb-8"
      />
      <h1 class="text-3xl font-black leading-tight sm:text-4xl">{title}</h1>
      {
        updated && (
          <p class="mt-4 text-xs text-muted-dark">
            {labels.updated}: {updated}
          </p>
        )
      }
    </div>
  </section>

  <section class="section-padding bg-surface">
    <div class="container-narrow">
      <article class="legal-prose">
        <slot />
      </article>
    </div>
  </section>
</Page>

<style is:global>
  @reference "../styles/global.css";

  .legal-prose h2 {
    @apply mt-10 mb-3 text-xl font-bold first:mt-0;
  }
  .legal-prose h3 {
    @apply mt-6 mb-2 text-base font-bold;
  }
  .legal-prose p {
    @apply mb-4 text-sm leading-relaxed text-ink-secondary;
  }
  .legal-prose ul {
    @apply mb-4 ml-5 list-disc space-y-1 text-sm leading-relaxed text-ink-secondary;
  }
  .legal-prose a {
    @apply text-accent underline underline-offset-2 hover:text-accent-dark;
  }
  .legal-prose .table-scroll {
    overflow-x: auto;
  }
  .legal-prose table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }
  .legal-prose th,
  .legal-prose td {
    border: 1px solid var(--color-muted);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal-prose thead th {
    background: var(--color-surface-alt);
    font-weight: 700;
  }
  .legal-prose .placeholder {
    @apply my-4 border-l-2 border-accent bg-accent-soft px-4 py-3 text-sm text-ink-secondary;
  }
</style>
