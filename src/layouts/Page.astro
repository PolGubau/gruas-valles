---
import Base from "./Base.astro";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: object | object[];
}

const { title, description, image, schema } = Astro.props;
---

<Base title={title} description={description} image={image} schema={schema}>
  <Navbar />
  <main id="main" class="inner-page">
    <slot />
  </main>
  <Footer />
</Base>

<style is:global>
  /* Reserve space for the fixed navbar inside the first section's background. */
  .inner-page > :first-child::before {
    content: "";
    display: block;
    height: 4rem;
  }
</style>
