---
import { Icon } from "astro-icon/components";
import { organizationsCopy } from "@i18n/organizations";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import creuRojaPdf from "../assets/docs/creu_roja.pdf";
import CtaBand from "../components/ui/CtaBand.astro";
import PageHero from "../components/ui/PageHero.astro";
import Page from "../layouts/Page.astro";

const lang = getLangFromUrl(Astro.url);
const copy = organizationsCopy(lang);
const localizePath = useTranslatedPath(lang);
const organismos = [
  {
    icon: "lucide:building-2",
    ...copy.organizations.anagrual,
    enlace: "https://www.anagrual.es",
    pdf: null,
  },
  {
    icon: "lucide:truck",
    ...copy.organizations.transcalit,
    enlace: null,
    pdf: null,
  },
  {
    icon: "lucide:heart-handshake",
    ...copy.organizations.redcross,
    enlace: null,
    pdf: creuRojaPdf,
  },
];
---

<Page title={`${copy.title} | Grúas del Vallès`} description={copy.description}>
  <PageHero
    title={copy.title}
    lede={copy.lede}
    crumbs={[
      { label: copy.home, href: localizePath("/") },
      { label: copy.breadcrumb },
    ]}
  />

  <!-- Intro -->
  <section class="section-padding bg-surface">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">
        <span class="h-px w-8 bg-accent"></span>{copy.eyebrow}
      </p>
      <h2 class="mb-6 text-2xl font-black sm:text-3xl">
        {copy.heading}
      </h2>
      <p class="leading-relaxed text-ink-secondary">
        {copy.intro}
      </p>
    </div>
  </section>

  <!-- Organismos -->
  <section class="section-padding bg-surface-alt">
    <div class="container-wide">
      <div class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-3">
        {
          organismos.map((o) => (
            <div class="flex flex-col gap-4 bg-surface p-6 sm:p-8">
              <Icon
                name={o.icon}
                class="h-8 w-8 text-accent"
                aria-hidden="true"
              />
              <div>
                <h3 class="text-lg font-bold">{o.name}</h3>
                <p class="mt-0.5 text-xs font-medium uppercase tracking-wider text-accent">
                  {o.full}
                </p>
              </div>
              <p class="flex-1 text-sm leading-relaxed text-ink-secondary">
                {o.description}
              </p>
              <div class="flex flex-col gap-2">
                {o.enlace && (
                  <a
                    href={o.enlace}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
                  >
                    <Icon
                      name="lucide:external-link"
                      class="h-4 w-4"
                      aria-hidden="true"
                    />
                    {copy.website}
                  </a>
                )}
                {o.pdf && (
                  <a
                    href={o.pdf}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
                  >
                    <Icon
                      name="lucide:download"
                      class="h-4 w-4"
                      aria-hidden="true"
                    />
                    {copy.download}
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Page>
