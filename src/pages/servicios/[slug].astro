---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { fleetCategory } from "@i18n/fleet";
import { serviceCategory, servicesCopy } from "@i18n/services";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import CtaBand from "../../components/ui/CtaBand.astro";
import PageHero from "../../components/ui/PageHero.astro";
import servicios from "../../data/servicios.json";
import Page from "../../layouts/Page.astro";

export async function getStaticPaths() {
  return servicios.categorias.map((cat) => ({
    params: { slug: cat.slug },
    props: { cat },
  }));
}

const lang = getLangFromUrl(Astro.url);
const localizePath = useTranslatedPath(lang);
const copy = servicesCopy(lang);
const cat = serviceCategory(lang, Astro.props.cat.slug);

const title = `${cat.titulo} | Grúas del Vallès`;
const description = `${cat.descripcion} ${copy.experience}`;

// Filtrar flota relacionada si aplica
const flotaRelacionada = (await getCollection("flota"))
  .filter((f) => {
    if (cat.slug === "gruas-moviles-autopropulsadas")
      return f.data.categoria === "Grúas móviles autopropulsadas";
    if (cat.slug === "montaje-estructuras-prefabricado")
      return (f.data.capacidad_max_t ?? 0) >= 100;
    return false;
  })
  .slice(0, 3);
---

<Page title={title} description={description}>
  <PageHero
    title={cat.titulo}
    lede={cat.descripcion}
    crumbs={[
      { label: copy.home, href: localizePath("/") },
      { label: copy.services, href: localizePath("/servicios") },
      { label: cat.titulo },
    ]}
  />

  <section class="section-padding bg-surface">
    <div class="container-wide">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="mb-6 text-2xl font-black sm:text-3xl">
            {copy.details}
          </h2>
          <ul class="space-y-4">
            {
              cat.detalles.map((d: string) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-secondary">
                  <Icon
                    name="lucide:check-circle"
                    class="mt-0.5 h-5 w-5 shrink-0 text-accent"
                    aria-hidden="true"
                  />
                  {d}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-surface-alt p-6 border-l-4 border-accent sm:p-8">
          <h3 class="mb-4 text-xl font-bold italic">{copy.didYouKnow}</h3>
          <p class="text-sm leading-relaxed text-ink-secondary">
            {copy.explanation}
          </p>
          <div class="mt-6 flex items-center gap-4">
            <Icon name="lucide:shield-check" class="h-10 w-10 text-accent/20" />
            <p
              class="text-xs font-semibold uppercase tracking-wider text-accent"
            >
              {copy.certification}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    flotaRelacionada.length > 0 && (
      <section class="section-padding bg-surface-alt">
        <div class="container-wide">
          <h2 class="mb-8 text-2xl font-black sm:text-3xl">{copy.fleet}</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {flotaRelacionada.map((f) => (
              <a
                href={localizePath(`/flota/${f.id}`)}
                class="group bg-surface p-5 border border-muted hover:border-accent transition-colors sm:p-6"
              >
                <p class="text-xs font-bold text-accent uppercase mb-2">
                  {fleetCategory(lang, f.data.categoria)}
                </p>
                <h3 class="text-lg font-bold group-hover:text-accent transition-colors">
                  {f.data.modelo}
                </h3>
                <span class="mt-4 flex items-center gap-2 text-xs font-bold uppercase tracking-widest">
                  {copy.sheet}{" "}
                  <Icon
                    name="lucide:arrow-right"
                    class="h-3 w-3 transition-transform group-hover:translate-x-1"
                  />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</Page>
