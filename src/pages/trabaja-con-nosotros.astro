---
import { Icon } from "astro-icon/components";
import { careersCopy } from "@i18n/careers";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import CtaBand from "../components/ui/CtaBand.astro";
import PageHero from "../components/ui/PageHero.astro";
import Page from "../layouts/Page.astro";

const lang = getLangFromUrl(Astro.url);
const copy = careersCopy(lang);
const localizePath = useTranslatedPath(lang);
const profileIcons = [
  "lucide:truck",
  "lucide:wrench",
  "lucide:hard-hat",
  "lucide:file-text",
];
const benefitIcons = [
  "lucide:calendar-check",
  "lucide:graduation-cap",
  "lucide:users",
  "lucide:shield-check",
  "lucide:map-pin",
  "lucide:trending-up",
];
const emailCandidatura = "gruasdelvalles@gruasdelvalles.com";
---

<Page title={`${copy.title} | Grúas del Vallès`} description={copy.description}>
  <PageHero
    title={copy.hero}
    lede={copy.lede}
    crumbs={[
      { label: copy.home, href: localizePath("/") },
      { label: copy.title },
    ]}
  />

  <!-- Perfiles buscados -->
  <section class="section-padding bg-surface">
    <div class="container-wide">
      <div class="mb-12 max-w-2xl">
        <p class="eyebrow">{copy.profiles}</p>
        <h2 class="text-3xl font-black leading-tight sm:text-4xl">
          {copy.profilesTitle}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-secondary">
          {copy.profilesIntro}
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          copy.jobs.map((p, i) => (
            <div class="flex flex-col gap-4 border-2 border-muted bg-surface p-6">
              <span class="flex h-12 w-12 items-center justify-center bg-accent-soft text-accent">
                <Icon
                  name={profileIcons[i]}
                  class="h-6 w-6"
                  aria-hidden="true"
                />
              </span>
              <h3 class="text-lg font-bold">{p.titulo}</h3>
              <p class="grow text-sm leading-relaxed text-ink-secondary">
                {p.descripcion}
              </p>
              <ul class="space-y-1.5 border-t border-muted/60 pt-4">
                {p.requisitos.map((r) => (
                  <li class="flex items-center gap-2 text-xs text-ink-secondary">
                    <Icon
                      name="lucide:check"
                      class="h-3.5 w-3.5 shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    {r}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="section-padding bg-surface-alt">
    <div class="container-wide">
      <div class="mb-12 max-w-2xl">
        <p class="eyebrow">{copy.why}</p>
        <h2 class="text-3xl font-black leading-tight sm:text-4xl">
          {copy.offer}
        </h2>
      </div>
      <div class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-3">
        {
          copy.benefits.map((benefit, i) => (
            <div class="flex items-start gap-4 bg-surface p-6 sm:p-8">
              <Icon
                name={benefitIcons[i]}
                class="mt-0.5 h-5 w-5 shrink-0 text-accent"
                aria-hidden="true"
              />
              <p class="text-sm font-medium leading-relaxed">{benefit}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA candidatura espontánea -->
  <section class="section-padding bg-ink text-white">
    <div class="container-narrow text-center">
      <p class="eyebrow text-white/80">{copy.spontaneous}</p>
      <h2 class="mt-4 text-3xl font-black sm:text-4xl">
        {copy.spontaneousTitle}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted">
        {copy.spontaneousText}
      </p>
      <a
        href={`mailto:${emailCandidatura}?subject=${encodeURIComponent(copy.subject)}`}
        class="btn mt-8 inline-flex items-center gap-2.5 bg-accent px-8 py-4 text-base font-bold text-white transition-colors hover:bg-accent-dark"
      >
        <Icon name="lucide:send" class="h-5 w-5" aria-hidden="true" />
        {copy.send}
      </a>
      <p class="mt-4 text-xs text-muted-dark">
        {emailCandidatura}
      </p>
    </div>
  </section>

  <CtaBand />
</Page>
