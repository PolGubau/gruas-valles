---
import { Icon } from "astro-icon/components";
import { localitiesCopy, localityIntro } from "@i18n/localities";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import Clientes from "../../components/sections/Clientes.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import PageHero from "../../components/ui/PageHero.astro";
import localidades from "../../data/localidades.json";
import Page from "../../layouts/Page.astro";
import { localServiceSchema } from "../../lib/schema";

export async function getStaticPaths() {
  return localidades.map((loc) => ({
    params: { localidad: loc.slug },
    props: { loc },
  }));
}

const { loc } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = localitiesCopy(lang);
const localizePath = useTranslatedPath(lang);
const title = `${copy.rentalIn(loc.nombre)} | Grúas del Vallès`;
const description = copy.detailDescription(loc.nombre, loc.comarca);
const url = localizePath(`/alquiler-gruas/${loc.slug}`);

const schema = localServiceSchema(
  {
    locality: loc.nombre,
    description,
    url,
    areaServed: loc.comarca,
    serviceType: copy.rentalIn(loc.nombre),
  },
  Astro.site,
);
---

<Page title={title} description={description} schema={schema}>
  <PageHero
    title={copy.rentalIn(loc.nombre)}
    lede={localityIntro(lang, loc.slug, loc.intro)}
    crumbs={[
      { label: copy.home, href: localizePath("/") },
      { label: copy.rental, href: localizePath("/alquiler-gruas") },
      { label: loc.nombre },
    ]}
  />

  <!-- Servicios disponibles en la localidad -->
  <section class="section-padding bg-surface">
    <div class="container-wide">
      <div class="mb-10 max-w-2xl">
        <p class="eyebrow">
          <span class="h-px w-8 bg-accent"></span>{copy.offering(loc.nombre)}
        </p>
        <h2 class="text-2xl font-black sm:text-3xl">
          {copy.solutions}
        </h2>
      </div>
      <ul class="grid gap-px bg-muted sm:grid-cols-2">
        {
          copy.services.map((s: string) => (
            <li class="flex items-start gap-3 bg-surface p-5 text-sm leading-relaxed text-ink-secondary sm:p-6">
              <Icon
                name="lucide:check"
                class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                aria-hidden="true"
              />
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Por qué elegirnos + accesos -->
  <section class="section-padding bg-surface-alt">
    <div class="container-wide grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">
          <span class="h-px w-8 bg-accent"></span>{copy.why}
        </p>
        <h2 class="mb-6 text-2xl font-black sm:text-3xl">
          {copy.reliable(loc.nombre)}
        </h2>
        <ul class="space-y-3">
          {
            copy.reasons.map((p: string) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-secondary">
                <Icon
                  name="lucide:badge-check"
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                {p}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-6">
        <div class="border-l-2 border-accent pl-4">
          <p class="mb-1 text-sm font-bold">{copy.access}</p>
          <p class="text-sm leading-relaxed text-ink-secondary">
            {copy.accessText(loc.nombre, loc.accesos)}
          </p>
        </div>
        <div class="border-l-2 border-accent pl-4">
          <p class="mb-1 text-sm font-bold">{copy.emergency}</p>
          <p class="text-sm leading-relaxed text-ink-secondary">
            {copy.emergencyText}
          </p>
        </div>
        <div class="border-l-2 border-accent pl-4">
          <p class="mb-1 text-sm font-bold">{copy.study}</p>
          <p class="text-sm leading-relaxed text-ink-secondary">
            {copy.studyText(loc.nombre)}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Prueba social: empresas que confían en nosotros -->
  <Clientes title={copy.clients(loc.nombre)} />

  <CtaBand />
</Page>
