---
import { Icon } from "astro-icon/components";
import { localitiesCopy } from "@i18n/localities";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import CtaBand from "../../components/ui/CtaBand.astro";
import PageHero from "../../components/ui/PageHero.astro";
import localidades from "../../data/localidades.json";
import Page from "../../layouts/Page.astro";
import { collectionPageSchema } from "../../lib/schema";

const lang = getLangFromUrl(Astro.url);
const copy = localitiesCopy(lang);
const localizePath = useTranslatedPath(lang);
const ciudades = localidades.filter((l) => l.tipo === "ciudad");
const zonas = localidades.filter((l) => l.tipo === "zona");

const description = copy.description;

const schema = collectionPageSchema(
  {
    name: copy.title,
    description,
    url: localizePath("/alquiler-gruas"),
    items: localidades.map((l) => ({
      name: copy.rentalIn(l.nombre),
      url: localizePath(`/alquiler-gruas/${l.slug}`),
    })),
  },
  Astro.site,
);
---

<Page
  title={`${copy.title} | Grúas del Vallès`}
  description={description}
  schema={schema}
>
  <PageHero
    title={copy.title}
    lede={copy.intro}
    crumbs={[
      { label: copy.home, href: localizePath("/") },
      { label: copy.rental },
    ]}
  />

  <!-- Ciudades principales -->
  <section class="section-padding bg-surface">
    <div class="container-wide">
      <div class="mb-8">
        <p class="eyebrow">
          <span class="h-px w-8 bg-accent"></span>{copy.cities}
        </p>
        <h2 class="text-2xl font-black sm:text-3xl">{copy.municipalities}</h2>
      </div>
      <ul class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-3">
        {
          ciudades.map((l) => (
            <li>
              <a
                href={localizePath(`/alquiler-gruas/${l.slug}`)}
                class="group flex h-full flex-col bg-surface p-5 transition-colors hover:bg-surface-alt sm:p-6"
              >
                <span class="mb-1 text-xs uppercase tracking-wider text-accent">
                  {l.comarca}
                </span>
                <span class="flex items-center justify-between text-lg font-bold">
                  {copy.craneIn(l.nombre)}
                  <Icon
                    name="lucide:arrow-right"
                    class="h-4 w-4 text-accent transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Zonas y comarcas -->
  <section class="section-padding bg-surface-alt">
    <div class="container-wide">
      <div class="mb-8">
        <p class="eyebrow">
          <span class="h-px w-8 bg-accent"></span>{copy.regions}
        </p>
        <h2 class="text-2xl font-black sm:text-3xl">{copy.regionalCoverage}</h2>
      </div>
      <ul class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-4">
        {
          zonas.map((l) => (
            <li>
              <a
                href={localizePath(`/alquiler-gruas/${l.slug}`)}
                class="group flex h-full flex-col bg-surface p-5 transition-colors hover:bg-surface-alt sm:p-6"
              >
                <span class="mb-1 text-xs uppercase tracking-wider text-accent">
                  {copy.region}
                </span>
                <span class="flex items-center justify-between text-lg font-bold">
                  {copy.craneIn(l.nombre)}
                  <Icon
                    name="lucide:arrow-right"
                    class="h-4 w-4 text-accent transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Page>
