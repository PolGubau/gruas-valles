---
import { Icon } from "astro-icon/components";
import Clientes from "../components/sections/Clientes.astro";
import ServiciosGrid from "../components/sections/ServiciosGrid.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import PageHero from "../components/ui/PageHero.astro";
import { servicesCopy } from "@i18n/services";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import Page from "../layouts/Page.astro";

const lang = getLangFromUrl(Astro.url);
const copy = servicesCopy(lang);
const localizePath = useTranslatedPath(lang);
const icons = [
  "lucide:clipboard-list",
  "lucide:route",
  "lucide:file-check-2",
  "lucide:construction",
];
---

<Page title={`${copy.title} | Grúas del Vallès`} description={copy.description}>
  <PageHero
    title={copy.heading}
    lede={copy.intro}
    crumbs={[
      { label: copy.home, href: localizePath("/") },
      { label: copy.services },
    ]}
  />

  <!-- Prueba social: empresas que confían en nosotros -->
  <Clientes bg="alt" />

  <!-- Servicios principales (sección reutilizada) -->
  <ServiciosGrid />

  <!-- Cómo trabajamos -->
  <section class="section-padding bg-surface-alt">
    <div class="container-wide">
      <div class="mb-12 max-w-2xl">
        <p class="eyebrow">
          {copy.process}
        </p>
        <h2 class="text-3xl font-black leading-tight sm:text-4xl">
          {copy.engineering}
        </h2>
      </div>
      <ol class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-4">
        {
          copy.steps.map((paso, i) => (
            <li class="bg-surface p-6 sm:p-8">
              <div class="mb-5 flex items-center justify-between">
                <span class="flex h-10 w-10 items-center justify-center border-2 border-muted">
                  <Icon
                    name={icons[i]}
                    class="h-5 w-5 text-accent"
                    aria-hidden="true"
                  />
                </span>
                <span class="text-3xl font-black text-muted">0{i + 1}</span>
              </div>
              <h3 class="mb-2 text-base font-bold">{paso.titulo}</h3>
              <p class="text-sm leading-relaxed text-ink-secondary">
                {paso.texto}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Trámites y asesoramiento -->
  <section class="section-padding bg-surface">
    <div class="container-wide grid gap-12 lg:grid-cols-2">
      <!-- Trámites -->
      <div>
        <p class="eyebrow">
          {copy.paperwork}
        </p>
        <h2 class="mb-6 text-2xl font-black sm:text-3xl">
          {copy.paperworkTitle}
        </h2>
        <ul class="space-y-3">
          {
            copy.procedures.map((t: string) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-secondary">
                <Icon
                  name="lucide:check"
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                {t}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Asesoramiento -->
      <div>
        <p class="eyebrow">
          {copy.support}
        </p>
        <h2 class="mb-6 text-2xl font-black sm:text-3xl">
          {copy.supportTitle}
        </h2>
        <dl class="space-y-6">
          {
            copy.supportLabels.map((label, i) => (
              <div class="border-l-2 border-accent pl-4">
                <dt class="mb-1 text-sm font-bold">{label}</dt>
                <dd class="text-sm leading-relaxed text-ink-secondary">
                  {copy.supportText[i]}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <CtaBand />
</Page>
