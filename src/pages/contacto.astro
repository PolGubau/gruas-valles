---
import { Icon } from "astro-icon/components";
import Clientes from "../components/sections/Clientes.astro";
import ContactoSection from "../components/sections/ContactoSection.astro";
import DondeEstamos from "../components/sections/DondeEstamos.astro";
import PageHero from "../components/ui/PageHero.astro";
import contacto from "../data/contacto.json";
import { contactCopy } from "@i18n/contact";
import { homeCopy } from "@i18n/home";
import { getLangFromUrl } from "@i18n/utils";
import Page from "../layouts/Page.astro";

const lang = getLangFromUrl(Astro.url);
const copy = contactCopy(lang);
const home = homeCopy(lang);
const garantias = [
  { icon: "lucide:clock", texto: copy.guarantees[0] },
  { icon: "lucide:file-text", texto: copy.guarantees[1] },
  { icon: "lucide:headset", texto: copy.guarantees[2] },
  { icon: "lucide:shield-check", texto: copy.guarantees[3] },
];

const telHref = `tel:${contacto.telefono.replace(/\s/g, "")}`;
const emergenciaHref = `tel:+34${contacto.emergencias[0].replace(/\s/g, "")}`;

const acciones = [
  {
    icon: "lucide:phone",
    label: copy.call,
    valor: contacto.telefono,
    href: telHref,
    nota: copy.commercial,
    valorClase: "text-lg",
  },
  {
    icon: "lucide:mail",
    label: copy.write,
    valor: contacto.email,
    href: `mailto:${contacto.email}`,
    nota: copy.response,
    valorClase: "text-sm sm:text-base",
  },
  {
    icon: "lucide:triangle-alert",
    label: copy.emergency,
    valor: contacto.emergencias.join(" · "),
    href: emergenciaHref,
    nota: copy.urgent,
    valorClase: "text-lg",
  },
];

const site = Astro.site ?? new URL("https://www.gruasdelvalles.com");
const pageUrl = new URL(Astro.url.pathname, site).href;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: `${copy.title} | Grúas del Vallès`,
    url: pageUrl,
    mainEntity: {
      "@type": "Organization",
      name: contacto.empresa,
      url: site.href,
      email: contacto.email,
      telephone: "+34938497022",
      contactPoint: [
        {
          "@type": "ContactPoint",
          telephone: "+34938497022",
          contactType: "customer service",
          areaServed: "ES",
          availableLanguage: ["es", "ca"],
        },
        {
          "@type": "ContactPoint",
          telephone: "+34669296954",
          contactType: "emergency",
          areaServed: "ES",
          availableLanguage: ["es", "ca"],
        },
      ],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: copy.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Page
  title={`${copy.title} | Grúas del Vallès`}
  description={copy.description}
  schema={schema}
>
  <PageHero
    title={copy.heading}
    lede={copy.intro}
    crumbs={[
      { label: copy.home, href: lang === "es" ? "/?lang=es" : `/${lang}/` },
      { label: copy.contact },
    ]}
  />

  <!-- Garantías -->
  <section class="border-b border-muted/40 bg-surface">
    <div class="container-wide grid grid-cols-2 gap-px lg:grid-cols-4">
      {
        garantias.map((g) => (
          <div class="flex items-center gap-3 px-4 py-5 sm:px-6 sm:py-6">
            <Icon
              name={g.icon}
              class="h-5 w-5 shrink-0 text-accent"
              aria-hidden="true"
            />
            <p class="min-w-0 wrap-anywhere text-sm font-medium">{g.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Prueba social: empresas que confían en nosotros -->
  <Clientes bg="alt" />

  <!-- Acciones rápidas de contacto -->
  <section class="section-padding pb-0">
    <div class="container-wide">
      <div class="grid gap-4 md:grid-cols-3">
        {
          acciones.map((a) => (
            <a
              href={a.href}
              class="group flex flex-col gap-3 border-2 border-muted bg-surface p-5 transition-colors hover:border-accent sm:p-6"
            >
              <span class="flex h-11 w-11 items-center justify-center bg-accent-soft text-accent">
                <Icon name={a.icon} class="h-5 w-5" aria-hidden="true" />
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-secondary">
                {a.label}
              </span>
              <span
                class:list={[
                  "font-bold text-ink transition-colors group-hover:text-accent wrap-anywhere",
                  a.valorClase,
                ]}
              >
                {a.valor}
              </span>
              <span class="text-xs text-ink-secondary">{a.nota}</span>
            </a>
          ))
        }
      </div>

      <!-- Horario y cobertura -->
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div
          class="flex items-start gap-3 border-2 border-muted bg-surface p-5 sm:p-6"
        >
          <Icon
            name="lucide:clock"
            class="mt-0.5 h-5 w-5 shrink-0 text-accent"
            aria-hidden="true"
          />
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-ink-secondary"
            >
              {copy.hours}
            </p>
            <p class="mt-1 text-sm font-medium">
              {copy.weekdays}
            </p>
            <p class="mt-1 text-sm font-semibold text-accent">
              {copy.emergencyHours}
            </p>
          </div>
        </div>
        <div
          class="flex items-start gap-3 border-2 border-muted bg-surface p-5 sm:p-6"
        >
          <Icon
            name="lucide:map-pin"
            class="mt-0.5 h-5 w-5 shrink-0 text-accent"
            aria-hidden="true"
          />
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-ink-secondary"
            >
              {copy.coverage}
            </p>
            <p class="mt-1 text-sm font-medium">{copy.coverageArea}</p>
            <p class="mt-1 text-sm text-ink-secondary">
              {copy.access}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Dónde estamos (Nueva sección con copy antiguo) -->
  <DondeEstamos />

  <!-- Formulario + info (sección reutilizada) -->
  <ContactoSection />

  <!-- Preguntas frecuentes -->
  <section class="section-padding bg-surface" aria-labelledby="faq-title">
    <div class="container-narrow">
      <h2 id="faq-title" class="mb-8 text-3xl font-black sm:text-4xl">
        {home.faqTitle}
      </h2>
      <div class="divide-y divide-muted/60 border-y border-muted/60">
        {
          copy.faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold">
                {f.q}
                <Icon
                  name="lucide:plus"
                  class="h-5 w-5 shrink-0 text-accent transition-transform group-open:rotate-45"
                  aria-hidden="true"
                />
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink-secondary">
                {f.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Page>
