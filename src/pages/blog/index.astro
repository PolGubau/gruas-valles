---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { collectionPageSchema } from "../../lib/schema";
import { blogCopy, translatedPost } from "@i18n/blog";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const copy = blogCopy(lang);
const localizePath = useTranslatedPath(lang);
const entries = await getCollection("blog");
const posts = entries
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => a.orden - b.orden);

const description = copy.description;
const schema = collectionPageSchema(
  {
    name: copy.title,
    description,
    url: localizePath("/blog"),
    items: posts.map((p) => ({
      name: translatedPost(lang, p.slug)?.titulo ?? p.titulo,
      url: localizePath(`/blog/${p.slug}`),
    })),
  },
  Astro.site,
);

const crumbs = [
  { label: copy.home, href: localizePath("/") },
  { label: copy.news, href: localizePath("/blog") },
];
---

<Page
  title={`${copy.title} | Grúas del Vallès`}
  description={description}
  schema={schema}
>
  <section class="section-padding bg-surface-alt">
    <div class="container-wide">
      <Breadcrumb items={crumbs} class="mb-8" />

      <header class="mb-12 max-w-2xl">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 class="text-3xl font-black leading-tight sm:text-4xl">
          {copy.heading}
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-ink-secondary">
          {copy.intro}
        </p>
      </header>

      <!-- Grid -->
      <div class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </section>
</Page>
