---
import { getCollection } from "astro:content";
import {
  fleetCategory,
  fleetCopy,
  isAuxiliaryFleetCategory,
} from "@i18n/fleet";
import { homeCopy } from "@i18n/home";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import FlotaCard from "../../components/flota/FlotaCard.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Button from "../../components/ui/Button.astro";
import Page from "../../layouts/Page.astro";
import { catalogo } from "../../lib/docs";
import { collectionPageSchema } from "../../lib/schema";

const lang = getLangFromUrl(Astro.url);
const copy = fleetCopy(lang);
const home = homeCopy(lang);
const localizePath = useTranslatedPath(lang);
const entries = await getCollection("flota");
const allModels = entries
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort(
    (a, b) =>
      Number(isAuxiliaryFleetCategory(a.categoria)) -
        Number(isAuxiliaryFleetCategory(b.categoria)) || a.orden - b.orden,
  );

const categorias = [...new Set(allModels.map((m) => m.categoria))];

const description = copy.description;
const schema = collectionPageSchema(
  {
    name: copy.title,
    description,
    url: localizePath("/flota"),
    items: allModels.map((m) => ({
      name: m.modelo,
      url: localizePath(`/flota/${m.slug}`),
    })),
  },
  Astro.site,
);

const crumbs = [
  { label: copy.home, href: localizePath("/") },
  { label: copy.fleet, href: localizePath("/flota") },
];
---

<Page
  title={`${copy.title} | Grúas del Vallès`}
  description={description}
  schema={schema}
>
  <section class="section-padding bg-surface-alt">
    <div class="container-wide">
      <Breadcrumb items={crumbs} class="mb-8" />

      <header class="mb-12 max-w-2xl">
        <p class="eyebrow">
          {copy.eyebrow}
        </p>
        <h1 class="text-3xl font-black leading-tight sm:text-4xl">
          {allModels.length}
          {copy.units}
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-ink-secondary">
          {copy.intro}
        </p>
      </header>

      <!-- Controles: filtros + ordenación -->
      <div class="mb-8 flex flex-wrap items-center gap-3">
        <!-- Filtros por categoría -->
        <div
          class="flex min-w-0 max-w-full flex-wrap gap-2"
          id="flota-filters"
          role="group"
          aria-label={copy.filter}
        >
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="filter-btn active-filter px-4 py-2 text-xs font-semibold uppercase tracking-wider border-2 border-accent bg-accent text-white transition-colors"
          >
            {copy.all}
          </button>
          {
            categorias.map((cat) => (
              <button
                type="button"
                data-filter={cat}
                aria-pressed="false"
                class="filter-btn max-w-full wrap-anywhere px-4 py-2 text-xs font-semibold uppercase tracking-wider border-2 border-muted text-ink-secondary transition-colors hover:border-accent hover:text-accent"
              >
                {fleetCategory(lang, cat)}
              </button>
            ))
          }
        </div>

        <!-- Separador -->
        <div class="hidden h-6 w-px bg-muted sm:block" aria-hidden="true"></div>

        <!-- Ordenar por capacidad dentro de cada grupo -->
        <button
          type="button"
          id="sort-tonelaje"
          data-sort="none"
          aria-label={copy.sort}
          data-label-none={copy.sortLabels[0]}
          data-label-desc={copy.sortLabels[1]}
          data-label-asc={copy.sortLabels[2]}
          class="flex items-center gap-1.5 px-4 py-2 text-xs font-semibold uppercase tracking-wider border-2 border-muted text-ink-secondary transition-colors hover:border-accent hover:text-accent"
        >
          <svg
            id="sort-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 6h18M7 12h10M11 18h2"></path>
          </svg>
          <span id="sort-label">{copy.sortLabels[0]}</span>
        </button>
      </div>

      <!-- Grid -->
      <div
        class="grid gap-px bg-white sm:grid-cols-2 lg:grid-cols-3"
        id="flota-grid"
      >
        {allModels.map((model) => <FlotaCard model={model} />)}
      </div>

      <!-- CTA -->
      <div
        class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
      >
        <Button href={localizePath("/#contacto")} icon="lucide:arrow-right">
          {copy.availability}
        </Button>
        <Button
          href={catalogo.url}
          download={catalogo.filename}
          variant="outline"
          icon="lucide:download"
          iconPosition="start"
        >
          {home.download}
        </Button>
      </div>
    </div>
  </section>
</Page>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const grid = document.getElementById("flota-grid")!;
  const sortBtn = document.getElementById("sort-tonelaje") as HTMLButtonElement;
  const sortLabel = document.getElementById("sort-label")!;
  const sortIcon = document.getElementById("sort-icon")!;

  // Ciclo: none → desc → asc → none
  type SortOrder = "none" | "desc" | "asc";
  let sortOrder: SortOrder = "none";
  let activeFilter = "all";

  const SORT_CONFIG: Record<
    SortOrder,
    { next: SortOrder; label: string; path: string }
  > = {
    none: {
      next: "desc",
      label: sortBtn.dataset.labelNone!,
      path: "M3 6h18M7 12h10M11 18h2",
    },
    desc: {
      next: "asc",
      label: sortBtn.dataset.labelDesc!,
      path: "M3 6h18M7 12h10M11 18h2",
    },
    asc: {
      next: "none",
      label: sortBtn.dataset.labelAsc!,
      path: "M3 6h18M7 12h10M11 18h2",
    },
  };

  function applyFilterAndSort() {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".flota-card"));

    // 1. Visibilidad por categoría
    cards.forEach((card) => {
      const show =
        activeFilter === "all" || card.dataset.categoria === activeFilter;
      card.style.display = show ? "" : "none";
    });

    // 2. Reordenar en el DOM
    const visible = cards.filter((c) => c.style.display !== "none");
    const hidden = cards.filter((c) => c.style.display === "none");

    const sorted = visible.sort((a, b) => {
      const group = Number(a.dataset.grupo) - Number(b.dataset.grupo);
      const originalOrder = Number(a.dataset.orden) - Number(b.dataset.orden);
      if (group || sortOrder === "none") return group || originalOrder;

      const ta = a.dataset.tonelaje;
      const tb = b.dataset.tonelaje;
      if (!ta || !tb) return Number(!ta) - Number(!tb) || originalOrder;
      const difference =
        sortOrder === "desc"
          ? Number(tb) - Number(ta)
          : Number(ta) - Number(tb);
      return difference || originalOrder;
    });
    [...sorted, ...hidden].forEach((c) => grid.appendChild(c));
  }

  // Filtros por categoría
  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeFilter = btn.dataset.filter!;

      filters.forEach((b) => {
        b.classList.remove(
          "active-filter",
          "bg-accent",
          "text-white",
          "border-accent",
        );
        b.classList.add("border-muted", "text-ink-secondary");
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.add(
        "active-filter",
        "bg-accent",
        "text-white",
        "border-accent",
      );
      btn.classList.remove("border-muted", "text-ink-secondary");
      btn.setAttribute("aria-pressed", "true");

      applyFilterAndSort();
    });
  });

  // Botón de ordenación
  sortBtn.addEventListener("click", () => {
    sortOrder = SORT_CONFIG[sortOrder].next;
    const cfg = SORT_CONFIG[sortOrder];

    sortLabel.textContent = cfg.label;

    const isActive = sortOrder !== "none";
    sortBtn.classList.toggle("border-accent", isActive);
    sortBtn.classList.toggle("text-accent", isActive);
    sortBtn.classList.toggle("border-muted", !isActive);
    sortBtn.classList.toggle("text-ink-secondary", !isActive);

    // Actualizar icono de dirección
    const pathEl = sortIcon.querySelector("path")!;
    if (sortOrder === "desc") {
      pathEl.setAttribute("d", "M3 6h18M7 12h10M11 18h2");
      sortIcon.style.transform = "scaleY(1)";
    } else if (sortOrder === "asc") {
      pathEl.setAttribute("d", "M3 6h18M7 12h10M11 18h2");
      sortIcon.style.transform = "scaleY(-1)";
    } else {
      sortIcon.style.transform = "scaleY(1)";
    }

    applyFilterAndSort();
  });
</script>
