---
import { Icon } from "astro-icon/components";
import { safetyCopy } from "@i18n/safety";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import reaPdf from "../assets/docs/certificado_rea.pdf";
import dunsPdf from "../assets/docs/duns.pdf";
import CtaBand from "../components/ui/CtaBand.astro";
import PageHero from "../components/ui/PageHero.astro";
import Page from "../layouts/Page.astro";

const lang = getLangFromUrl(Astro.url);
const copy = safetyCopy(lang);
const localizePath = useTranslatedPath(lang);
const certificaciones = [
  {
    icon: "lucide:shield-check",
    ...copy.items.reic,
    pdf: null,
  },
  {
    icon: "lucide:building-2",
    ...copy.items.rea,
    pdf: reaPdf,
  },
  {
    icon: "lucide:lock",
    ...copy.items.lopd,
    pdf: null,
  },
  {
    icon: "lucide:badge-check",
    ...copy.items.duns,
    pdf: dunsPdf,
  },
  {
    icon: "lucide:wrench",
    ...copy.items.workshop,
    pdf: null,
  },
];
---

<Page title={`${copy.label} | Grúas del Vallès`} description={copy.description}>
  <PageHero
    title={copy.title}
    lede={copy.lede}
    crumbs={[
      { label: copy.home, href: localizePath("/") },
      { label: copy.label },
    ]}
  />

  <!-- Intro -->
  <section class="section-padding bg-surface">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">
        <span class="h-px w-8 bg-accent"></span>{copy.eyebrow}
      </p>
      <h2 class="mb-6 text-2xl font-black sm:text-3xl">
        {copy.heading}
      </h2>
      <p class="leading-relaxed text-ink-secondary">
        {copy.intro}
      </p>
    </div>
  </section>

  <!-- Certificaciones -->
  <section class="section-padding bg-surface-alt">
    <div class="container-wide">
      <div class="mb-12 max-w-2xl">
        <p class="eyebrow">
          <span class="h-px w-8 bg-accent"></span>{copy.credentials}
        </p>
        <h2 class="text-3xl font-black leading-tight sm:text-4xl">
          {copy.guarantees}
        </h2>
      </div>

      <div class="grid gap-px bg-muted sm:grid-cols-2">
        {
          certificaciones.map((c) => (
            <div class="flex flex-col gap-4 bg-surface p-6 sm:p-8">
              <Icon
                name={c.icon}
                class="h-8 w-8 text-accent"
                aria-hidden="true"
              />
              <div>
                <h3 class="text-lg font-bold">{c.title}</h3>
                <p class="mt-0.5 text-xs font-medium uppercase tracking-wider text-accent">
                  {c.subtitle}
                </p>
              </div>
              <p class="flex-1 text-sm leading-relaxed text-ink-secondary">
                {c.description}
              </p>
              {c.pdf && (
                <a
                  href={c.pdf}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline"
                >
                  <Icon
                    name="lucide:download"
                    class="h-4 w-4"
                    aria-hidden="true"
                  />
                  {copy.download}
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Page>
