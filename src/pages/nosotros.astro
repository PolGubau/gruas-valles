---
import { Icon } from "astro-icon/components";
import { companyCopy } from "@i18n/company";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import Clientes from "../components/sections/Clientes.astro";
import NosotrosSection from "../components/sections/NosotrosSection.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import MapEmbed from "../components/ui/MapEmbed.astro";
import PageHero from "../components/ui/PageHero.astro";
import nosotros from "../data/nosotros.json";
import Page from "../layouts/Page.astro";
import { headquartersMapUrl } from "../lib/location";

const lang = getLangFromUrl(Astro.url);
const copy = companyCopy(lang);
const localizePath = useTranslatedPath(lang);
const anios = new Date().getFullYear() - nosotros.fundacion;
const stats = [
  { valor: `${anios}+`, label: copy.stats[0] },
  { valor: "700 Tn", label: copy.stats[1] },
  { valor: "24/365", label: copy.stats[2] },
  { valor: "5.000 m²", label: copy.stats[3] },
];
const certificaciones = [
  { titulo: "REA", detalle: nosotros.seguridad.rea },
  { titulo: "REIC", detalle: nosotros.seguridad.reic },
  { titulo: "LOPD", detalle: copy.dataProtection },
];
---

<Page
  title={`${copy.title} | Grúas del Vallès`}
  description={copy.description(anios)}
>
  <PageHero
    title={copy.hero}
    lede={copy.lede}
    crumbs={[
      { label: copy.home, href: localizePath("/") },
      { label: copy.about },
    ]}
  />

  <!-- Stats band -->
  <section class="bg-ink text-white">
    <div class="container-wide grid grid-cols-2 gap-px lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="px-3 py-8 text-center sm:px-6 sm:py-10">
            <p class="text-3xl font-black text-accent sm:text-4xl">{s.valor}</p>
            <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Historia + por qué elegirnos (sección reutilizada) -->
  <NosotrosSection />

  <!-- Prueba social: empresas que confían en nosotros -->
  <Clientes bg="alt" />

  <!-- Certificaciones -->
  <section class="section-padding bg-surface">
    <div class="container-wide">
      <div class="mb-12 max-w-2xl">
        <p class="eyebrow">
          {copy.certification}
        </p>
        <h2 class="text-3xl font-black leading-tight sm:text-4xl">
          {copy.guarantees}
        </h2>
      </div>
      <div class="grid gap-px bg-muted sm:grid-cols-2 lg:grid-cols-4">
        {
          certificaciones.map((c) => (
            <div class="bg-surface p-6 sm:p-8">
              <Icon
                name="lucide:badge-check"
                class="mb-4 h-7 w-7 text-accent"
                aria-hidden="true"
              />
              <h3 class="mb-1 text-lg font-bold">{c.titulo}</h3>
              <p class="text-sm leading-relaxed text-ink-secondary">
                {c.detalle}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Instalaciones + Organismos -->
  <section class="section-padding bg-surface-alt">
    <div class="container-wide grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">
          {copy.facilities}
        </p>
        <h2 class="mb-6 text-2xl font-black sm:text-3xl">
          {copy.facilityTitle}
        </h2>
        <ul class="grid gap-2 sm:grid-cols-2">
          {
            copy.facilityItems.map((i: string) => (
              <li class="flex items-center gap-2 text-sm text-ink-secondary">
                <Icon
                  name="lucide:check"
                  class="h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                {i}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow">
          {copy.associations}
        </p>
        <h2 class="mb-6 text-2xl font-black sm:text-3xl">
          {copy.members}
        </h2>
        <ul class="space-y-3">
          {
            copy.associationItems.map((o: string) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-secondary">
                <Icon
                  name="lucide:users"
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                {o}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Ubicación -->
  <section class="section-padding bg-surface">
    <div class="container-wide grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">
          {copy.location}
        </p>
        <h2 class="mb-6 text-2xl font-black sm:text-3xl">
          {copy.nearCircuit}
        </h2>
        <dl class="space-y-4 text-sm">
          <div class="flex items-start gap-3">
            <Icon
              name="lucide:map-pin"
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              aria-hidden="true"
            />
            <dd>{nosotros.ubicacion.direccion}</dd>
          </div>
          <div class="flex items-start gap-3">
            <Icon
              name="lucide:milestone"
              class="mt-0.5 h-4 w-4 shrink-0 text-accent"
              aria-hidden="true"
            />
            <dd>
              {copy.access}: {
                nosotros.ubicacion.accesos
                  .replace("Carretera", lang === "en" ? "Road" : "Carretera")
                  .replace(
                    " y ",
                    lang === "ca" ? " i " : lang === "en" ? " and " : " y ",
                  )
              }
            </dd>
          </div>
        </dl>
      </div>
      <div class="min-h-96 bg-surface-alt">
        <MapEmbed
          src={headquartersMapUrl}
          title={copy.mapTitle}
        />
      </div>
    </div>
  </section>

  <CtaBand />
</Page>
