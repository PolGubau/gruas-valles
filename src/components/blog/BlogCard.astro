---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { resolveImage } from "../../lib/images";
import { formatBlogDate } from "../../lib/blog";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import { translatedPost } from "@i18n/blog";
import { homeCopy } from "@i18n/home";
import { publicBlogSlug } from "../../lib/blog-slugs.mjs";

interface Props {
  post: CollectionEntry<"blog">["data"] & { slug: string };
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = homeCopy(lang);
const localizePath = useTranslatedPath(lang);
const translated = translatedPost(lang, post.slug) ?? post;
---

<a
  href={localizePath(`/blog/${publicBlogSlug(post.slug)}`)}
  class="group flex flex-col overflow-hidden rounded-sm bg-white transition-shadow hover:shadow-card"
>
  <div class="aspect-video overflow-hidden bg-surface-alt">
    {
      post.imagenes.length > 0 ? (
        <img
          src={resolveImage(post.imagenes[0])}
          alt={translated.titulo}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex h-full items-center justify-center">
          <Icon
            name="lucide:newspaper"
            class="h-12 w-12 text-muted"
            aria-hidden="true"
          />
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <time
      datetime={post.fecha.toISOString().slice(0, 10)}
      class="mb-2 text-xs text-ink-secondary"
    >
      {formatBlogDate(post.fecha, lang)}
    </time>
    <h3
      class="mb-3 text-xl font-semibold leading-snug transition-colors group-hover:text-accent"
    >
      {translated.titulo}
    </h3>
    <p class="line-clamp-3 text-sm leading-relaxed text-ink-secondary">
      {translated.resumen}
    </p>

    <span
      class="mt-auto inline-flex items-center gap-2 pt-7 text-sm font-semibold text-accent"
    >
      {copy.readMore}
      <Icon
        name="lucide:arrow-right"
        width={16}
        height={16}
        aria-hidden="true"
      />
    </span>
  </div>
</a>
