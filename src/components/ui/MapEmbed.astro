---
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import { mapConsentCopy } from "@i18n/map-consent";

interface Props { src: string; title: string; }
const { src, title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = mapConsentCopy(lang);
const localizePath = useTranslatedPath(lang);
---
<div data-map-embed class="relative flex h-full min-h-96 w-full items-center justify-center bg-surface-alt">
  <div data-map-placeholder class="w-full max-w-lg p-6 text-center">
    <h3 class="text-lg font-bold">{copy.title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-ink-secondary">{copy.description}</p>
    <p class="mt-3 text-sm">
      <a href={localizePath("/legal/politica-cookies")} class="text-accent underline">{copy.policy}</a>
      · <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-accent underline">{copy.google}</a>
    </p>
    <div data-map-controls hidden>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <button type="button" data-map-allow class="btn btn-sm border-2 border-ink text-ink hover:bg-ink hover:text-white">{copy.allow}</button>
        <button type="button" data-map-deny class="btn btn-sm border-2 border-ink text-ink hover:bg-ink hover:text-white">{copy.deny}</button>
      </div>
    </div>
    <p data-map-status data-denied={copy.denied} class="mt-3 text-sm text-ink-secondary" role="status" hidden></p>
    <p class="mt-4 text-sm"><a href="https://www.google.com/maps/search/?api=1&query=Gr%C3%BAas+del+Vall%C3%A8s+Granollers" target="_blank" rel="noopener noreferrer" class="text-accent underline">{copy.external}</a></p>
  </div>
  <iframe data-map-src={src} title={title} class="absolute inset-0 h-full w-full border-0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" hidden></iframe>
</div>