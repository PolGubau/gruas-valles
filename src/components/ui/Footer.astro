---
import { Icon } from "astro-icon/components";
import localidades from "../../data/localidades.json";
import { catalogo } from "../../lib/docs";
import {
  getLangFromUrl,
  hasTranslations,
  useTranslatedPath,
} from "@i18n/utils";
import { homeCopy } from "@i18n/home";
import { mapConsentCopy } from "@i18n/map-consent";

const lang = getLangFromUrl(Astro.url);
const copy = homeCopy(lang);
const mapCopy = mapConsentCopy(lang);
const localizePath = useTranslatedPath(lang);
const year = new Date().getFullYear();

const serviciosLinks = [
  { href: "/flota", label: copy.footerFleet },
  { href: "/servicios", label: copy.footerServices },
];

const empresaLinks = [
  { href: "/nosotros", label: copy.footerAbout },
  { href: "/seguridad", label: copy.footerSafety },
  { href: "/organismos", label: copy.footerBodies },
  { href: "/blog", label: copy.footerNews },
  { href: "/trabaja-con-nosotros", label: copy.footerJobs },
  { href: "/contacto", label: copy.footerContact },
];

const zonas = localidades.slice(0, 6);

const legalLinks = [
  { href: "/legal/aviso-legal", label: copy.legalNotice },
  { href: "/legal/privacidad", label: copy.privacy },
  { href: "/legal/politica-cookies", label: copy.cookies },
];
---

<footer class="bg-ink text-muted">
  <div class="container-wide py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Brand + contacto -->
      <div class="lg:col-span-5">
        <a
          href={localizePath("/")}
          class="mb-5 inline-block"
          aria-label={lang === "en"
            ? "Grúas del Vallès - home"
            : lang === "ca"
              ? "Grúas del Vallès - inici"
              : "Grúas del Vallès - inicio"}
        >
          <img
            src="/logo.png"
            alt="Grúas del Vallès"
            class="h-12 w-auto brightness-0 invert"
            loading="lazy"
          />
        </a>
        <p class="max-w-sm text-sm leading-relaxed">
          {copy.footerDescription}
        </p>

        <div class="mt-8 space-y-4">
          <a
            href="tel:+34938497022"
            class="inline-flex items-center gap-2.5 text-lg font-semibold text-white transition-colors hover:text-accent-light"
          >
            <Icon
              name="lucide:phone"
              class="h-5 w-5 shrink-0 text-accent-light"
              aria-hidden="true"
            />
            93 849 70 22
          </a>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
            <span
              class="text-xs font-semibold uppercase tracking-wider text-muted"
            >
              {copy.emergencyShort}
            </span>
            <a
              href="tel:+34669296954"
              class="text-accent-light hover:underline"
            >
              669 29 69 54
            </a>
            <a
              href="tel:+34669296949"
              class="text-accent-light hover:underline"
            >
              669 29 69 49
            </a>
          </div>

          <a
            href="mailto:gruasdelvalles@gruasdelvalles.com"
            class="inline-flex max-w-full items-center gap-2.5 text-sm transition-colors hover:text-accent-light"
          >
            <Icon
              name="lucide:mail"
              class="h-4 w-4 shrink-0 text-accent-light"
              aria-hidden="true"
            />
            <span class="min-w-0 wrap-anywhere"
              >gruasdelvalles@gruasdelvalles.com</span
            >
          </a>

          <a
            href={catalogo.url}
            download={catalogo.filename}
            class="btn min-h-11 border-2 border-white/20 px-4 py-2.5 text-sm text-white hover:border-accent-light hover:text-accent-light"
          >
            <Icon
              name="lucide:download"
              class="h-4 w-4 shrink-0 text-accent-light"
              aria-hidden="true"
            />
            {copy.download}
          </a>
        </div>

        <div class="mt-8 flex items-center gap-3">
          <a
            href="https://www.youtube.com/channel/UCGAXK9VBR-OSxCsV3k2Ntkg"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.youtubeLabel}
            class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-muted transition-colors hover:bg-[#FF0000] hover:text-white"
          >
            <Icon name="lucide:youtube" class="h-4 w-4" aria-hidden="true" />
          </a>
          <a
            href="mailto:gruasdelvalles@gruasdelvalles.com"
            aria-label={copy.emailLabel}
            class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-muted transition-colors hover:bg-accent hover:text-white"
          >
            <Icon name="lucide:mail" class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>

      <!-- Columnas de enlaces -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
        <!-- Servicios -->
        <div>
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-wider text-white"
          >
            {copy.footerServices}
          </p>
          <ul class="space-y-2.5 text-sm">
            {
              serviciosLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={localizePath(href)}
                    class="transition-colors hover:text-accent-light"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Empresa -->
        <div>
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-wider text-white"
          >
            {copy.footerCompany}
          </p>
          <ul class="space-y-2.5 text-sm">
            {
              empresaLinks.map(({ href, label }) => (
                <li>
                  <a
                    href={hasTranslations(href) ? localizePath(href) : href}
                    class="transition-colors hover:text-accent-light"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Cobertura -->
        <div class="col-span-2 sm:col-span-1">
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-wider text-white"
          >
            {copy.footerCoverage}
          </p>
          <ul class="space-y-2.5 text-sm">
            {
              zonas.map((z) => (
                <li>
                  <a
                    href={localizePath(`/alquiler-gruas/${z.slug}`)}
                    class="transition-colors hover:text-accent-light"
                  >
                    {copy.footerCranes} {z.nombre}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={localizePath("/alquiler-gruas")}
                class="font-semibold text-accent-light hover:underline"
              >
                {copy.footerAllCoverage} →
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    {
      copy.spanishNotice && (
        <p class="mt-10 max-w-2xl text-sm text-muted">{copy.spanishNotice}</p>
      )
    }

    <!-- Barra inferior -->
    <div
      class="mt-14 flex flex-col gap-6 border-t border-white/10 pt-8 text-xs lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="space-y-1.5">
        <p>© {year} Grúas del Vallès, S.A. · CIF A08603888</p>
        <p class="text-muted">
          Avda. San Julián 64-66, Polígono Congost, 08403 Granollers
        </p>
      </div>

      <nav
        class="flex flex-wrap items-center gap-x-5 gap-y-2"
        aria-label={copy.legalLinks}
      >
        {
          legalLinks.map(({ href, label }) => (
            <a
              href={localizePath(href)}
              class="transition-colors hover:text-white"
            >
              {label}
            </a>
          ))
        }
        <button
          type="button"
          data-map-revoke
          hidden
          class="text-left underline hover:text-white">{mapCopy.revoke}</button
        >
      </nav>
      <p
        data-map-revoked-status
        data-message={mapCopy.revoked}
        role="status"
        tabindex="-1"
        hidden
        class="max-w-sm text-xs"
      >
      </p>
    </div>

    <p class="mt-6 text-[10px] opacity-40 transition-opacity hover:opacity-100">
      {copy.programmed}
      <a
        href="https://doscientos.es"
        target="_blank"
        rel="noopener"
        class="hover:text-white">Doscientos</a
      ><a
        href="https://polgubau.com"
        target="_blank"
        rel="noopener"
        class="opacity-0 hover:text-white">Pol Gubau</a
      >
    </p>
  </div>
</footer>
