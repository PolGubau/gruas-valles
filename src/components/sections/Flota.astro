---
import { getCollection } from "astro:content";
import { resolveImage } from "../../lib/images";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import { homeCopy } from "@i18n/home";
import { es } from "@i18n/home.es";

const lang = getLangFromUrl(Astro.url);
const copy = homeCopy(lang);
const localizePath = useTranslatedPath(lang);

// Fuente única: colección «flota» (ver src/content.config.ts)
const entries = await getCollection("flota");
const allModels = entries
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => a.orden - b.orden);

const destacados = allModels
  .filter(
    (model, index) =>
      allModels.findIndex((m) => m.categoria === model.categoria) === index,
  )
  .slice(0, 3);
---

<Section id="flota" bg="alt" title={copy.fleetTitle}>
  <p slot="intro">
    {copy.fleetIntro}
    <a href="#contacto" class="font-medium text-accent underline"
      >{copy.contactUs}</a
    >.
  </p>

  <!-- Selección representativa; el catálogo completo está en /flota. -->
  {
    destacados.length > 0 && (
      <div class="novedades-wrapper" data-reveal>
        {/* Cabecera */}
        <div class="novedades-header">
          <div class="novedades-header-inner">
            <div>
              <h3 class="novedades-title">{copy.fleetSelection}</h3>
              <p class="novedades-subtitle">{copy.fleetSubtitle}</p>
            </div>
          </div>
          <a href={localizePath("/flota")} class="novedades-link">
            {copy.allFleet} →
          </a>
        </div>

        {/* Tarjetas */}
        <div class="novedades-track">
          {destacados.map((model) => {
            const capacidad = model.capacidad_max_t ?? model.capacidad_tm;
            const categoryIndex = es.fleetCategories.indexOf(model.categoria);
            return (
              <a
                href={localizePath(`/flota/${model.slug}`)}
                class="novedades-card group"
              >
                <div class="novedades-img">
                  {model.imagenes.length > 0 ? (
                    <img
                      src={resolveImage(model.imagenes[0])}
                      alt={model.modelo}
                      class="h-full w-full object-contain p-4 transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : null}
                </div>
                <div class="novedades-card-body">
                  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-ink-secondary">
                    {copy.fleetCategories[categoryIndex] ?? model.categoria}
                  </p>
                  <h4 class="novedades-card-title group-hover:text-accent">
                    {model.modelo}
                  </h4>
                  {capacidad && (
                    <p class="novedades-card-cap">{capacidad} Tn</p>
                  )}
                  {model.nota && (
                    <p
                      class="novedades-card-nota"
                      lang={
                        lang !== "es" &&
                        model.nota !== "El mayor vehículo de la flota."
                          ? "es"
                          : undefined
                      }
                    >
                      {model.nota === "El mayor vehículo de la flota."
                        ? copy.fleetNote
                        : model.nota}
                    </p>
                  )}
                  <span class="novedades-card-cta">
                    {copy.technicalSheet} →
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )
  }

  <!-- CTA bottom -->
  <div class="mt-12 flex flex-wrap justify-center gap-4">
    <Button href={localizePath("/flota")} variant="outline" icon="lucide:list">
      {copy.allFleet}
    </Button>
    <Button href="#contacto" icon="lucide:arrow-right">
      {copy.availability}
    </Button>
  </div>
</Section>

<style>
  /* ── Wrapper ── */
  .novedades-wrapper {
    min-width: 0;
  }

  /* ── Cabecera ── */
  .novedades-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0 0 1.5rem;
  }

  .novedades-header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .novedades-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .novedades-title {
      font-size: 1.4rem;
    }
  }

  .novedades-subtitle {
    font-size: 0.875rem;
    color: var(--color-ink-secondary);
    margin: 0.2rem 0 0;
    letter-spacing: 0.01em;
  }

  .novedades-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .novedades-link:hover {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }

  /* ── Track de tarjetas ── */
  .novedades-track {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .novedades-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .novedades-track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ── Tarjeta individual ── */
  .novedades-card {
    min-width: 0;
    background: white;
    border-radius: 2px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .novedades-card:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  /* Imagen con badge superpuesto */
  .novedades-img {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: white;
  }

  .novedades-card-body {
    padding: 1.5rem;
    overflow-wrap: anywhere;
  }

  .novedades-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    transition: color 0.2s;
    margin: 0 0 0.25rem;
  }

  .novedades-card-cap {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0;
  }

  .novedades-card-nota {
    font-size: 0.875rem;
    color: var(--color-ink-secondary);
    margin: 0.35rem 0 0;
    line-height: 1.4;
  }

  .novedades-card-cta {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .novedades-card {
      transition: none;
      animation: none;
    }
  }
</style>
