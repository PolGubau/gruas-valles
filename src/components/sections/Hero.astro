---
import { getImage } from "astro:assets";
import heroImage from "../../assets/images/hero-grua-accion-2024-01.avif";
import industrialImage from "../../assets/images/galeria-industria-ltm1350-2021-01.avif";
import portImage from "../../assets/images/operacion-puerto-2020.avif";
import { catalogo } from "../../lib/docs";
import Button from "../ui/Button.astro";
import { getLangFromUrl } from "@i18n/utils";
import { homeCopy } from "@i18n/home";

const copy = homeCopy(getLangFromUrl(Astro.url));

// ── SLIDESHOW DE HERO ─────────────────────────────────────────────────────────
// Para cambiar fotos: añade o elimina objetos de este array.
// Cada foto permanece SLIDE_INTERVAL segundos; el vídeo se reproduce completo.
const SLIDE_INTERVAL = 7; // segundos

const heroSlides = [
  { src: heroImage },
  { src: industrialImage },
  { src: portImage },
];

const slides = await Promise.all(
  heroSlides.map(async (slide) => ({
    ...slide,
    image: await getImage({
      src: slide.src,
      width: Math.min(1200, slide.src.width),
      widths: [480, 768, 1200].filter((width) => width < slide.src.width),
      sizes: "100vw",
      format: "avif",
    }),
  })),
);
// ─────────────────────────────────────────────────────────────────────────────
---

<section
  id="hero"
  class="relative flex min-h-[calc(100svh-4rem)] flex-col justify-end overflow-hidden bg-ink sm:min-h-svh"
>
  <!-- Slideshow de fondo -->
  <div
    id="hero-slideshow"
    class="absolute inset-0 overflow-hidden"
    data-interval={SLIDE_INTERVAL}
  >
    <video
      src="/media/dron/video.mp4"
      poster="/media/dron/1.avif"
      class="hero-slide absolute inset-0 h-full w-full object-cover object-center"
      muted
      playsinline
      preload="none"
      aria-hidden="true"></video>
    {
      slides.map((slide, i) => (
        <img
          src={slide.src.src}
          srcset={`${slide.image.srcSet.attribute}, ${slide.src.src} ${slide.src.width}w`}
          sizes="100vw"
          width={slide.src.width}
          height={slide.src.height}
          alt=""
          aria-hidden="true"
          class={`hero-slide absolute inset-0 h-full w-full object-cover object-center${i === 0 ? " is-active" : ""}`}
          fetchpriority={i === 0 ? "high" : "low"}
          loading={i === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      ))
    }
    <div class="hero-overlay pointer-events-none absolute inset-0"></div>
  </div>

  <div
    class="container-wide relative z-10 px-4 pt-36 pb-10 sm:px-6 sm:pt-44 sm:pb-16 lg:px-8 lg:pb-20"
  >
    <div class="max-w-3xl">
      <p class="eyebrow mb-5 text-white/85 sm:mb-7">
        {copy.heroEyebrow}
      </p>
      <h1
        class="max-w-3xl text-[clamp(2.6rem,6vw,5.5rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-white"
      >
        {copy.heroFirst}<br />{copy.heroSecond}<span class="text-accent-light"
          >.</span
        >
      </h1>

      <p
        class="mt-6 max-w-xl text-base leading-relaxed text-white/85 sm:mt-7 sm:text-lg"
      >
        {copy.heroDescription}
      </p>

      <div class="mt-8 flex flex-col gap-3 min-[480px]:flex-row sm:mt-10">
        <Button
          href="#contacto"
          icon="lucide:arrow-right"
          class="min-h-12 w-full rounded-sm normal-case tracking-normal min-[480px]:w-auto"
        >
          {copy.consult}
        </Button>
        <Button
          href="tel:+34938497022"
          variant="outline"
          icon="lucide:phone"
          iconPosition="start"
          class="min-h-12 w-full rounded-sm border-white/70 text-white normal-case tracking-normal hover:bg-white hover:text-ink! min-[480px]:w-auto"
        >
          {copy.call} · 93 849 70 22
        </Button>
      </div>
      <a
        href={catalogo.url}
        download={catalogo.filename}
        class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-white/85 underline decoration-white/40 underline-offset-4 transition-colors hover:text-white"
      >
        {copy.download}
      </a>
    </div>

    <dl
      class="mt-10 grid max-w-2xl grid-cols-2 gap-x-6 gap-y-6 sm:mt-14 sm:grid-cols-3"
    >
      {
        [
          { value: "28", label: copy.cranes },
          { value: "24/365", label: copy.emergency },
          { value: "86", label: copy.vehicles },
        ].map(({ value, label }, i) => (
          <div
            class:list={["flex flex-col-reverse", { "hidden sm:flex": i >= 2 }]}
          >
            <dt class="mt-2 text-sm leading-snug text-white/80">{label}</dt>
            <dd class="text-2xl font-semibold leading-none tracking-tight text-white sm:text-3xl">
              {value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero-slide {
    opacity: 0;
    transform: scale(1.05);
    transition: opacity 1.5s ease-out;
  }
  .hero-slide.is-active {
    opacity: 1;
  }
  .hero-overlay {
    background:
      linear-gradient(
        90deg,
        rgb(10 10 10 / 0.78) 0%,
        rgb(10 10 10 / 0.58) 43%,
        rgb(10 10 10 / 0.16) 100%
      ),
      linear-gradient(0deg, rgb(10 10 10 / 0.78) 0%, rgb(10 10 10 / 0.08) 70%);
  }
  @media (prefers-reduced-motion: no-preference) {
    img.hero-slide.is-active {
      animation: hero-pan 7s ease-out both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      transition: none;
    }
  }
  @keyframes hero-pan {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.05);
    }
  }
</style>

<script>
  const container = document.getElementById("hero-slideshow");
  const slides = container?.querySelectorAll<HTMLElement>(".hero-slide");
  const video = container?.querySelector<HTMLVideoElement>("video.hero-slide");
  const interval = Number(container?.dataset.interval ?? 7) * 1000;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (slides && video && slides.length > 1) {
    // La primera foto es el respaldo mientras carga el vídeo o si falla.
    let current = 1;
    let timer: number | undefined;
    let generation = 0;

    const show = (index: number) => {
      slides[current].classList.remove("is-active");
      current = index;
      slides[current].classList.add("is-active");
    };

    const showPhoto = (index: number) => {
      video.pause();
      show(index);
      if (!reducedMotion.matches) timer = window.setTimeout(advance, interval);
    };

    const playVideo = () => {
      const attempt = ++generation;
      if (video.ended) video.currentTime = 0;
      video
        .play()
        .then(() => {
          if (attempt === generation && !reducedMotion.matches) show(0);
        })
        .catch(() => {
          if (attempt === generation && !reducedMotion.matches) showPhoto(1);
        });
    };

    function advance() {
      if (current === slides.length - 1) playVideo();
      else showPhoto(current + 1);
    }

    video.addEventListener("ended", () => {
      if (current === 0 && !reducedMotion.matches) showPhoto(1);
    });
    video.addEventListener("error", () => {
      if (current === 0 && !reducedMotion.matches) showPhoto(1);
    });

    const updatePlayback = () => {
      window.clearTimeout(timer);
      generation++;
      if (reducedMotion.matches) showPhoto(1);
      else playVideo();
    };

    reducedMotion.addEventListener("change", updatePlayback);
    updatePlayback();
  }
</script>
