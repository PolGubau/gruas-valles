---
import { getCollection } from "astro:content";
import BlogCard from "../blog/BlogCard.astro";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import { homeCopy } from "@i18n/home";
import { compareBlogDates } from "../../lib/blog";

const lang = getLangFromUrl(Astro.url);
const copy = homeCopy(lang);
const localizePath = useTranslatedPath(lang);

const entries = await getCollection("blog");
const trabajos = entries
  .map((entry) => ({ slug: entry.id, ...entry.data }))
  .sort(compareBlogDates)
  .slice(0, 3);
---

<Section id="trabajos" bg="alt" title={copy.worksTitle}>
  <p slot="intro">
    {copy.worksIntro}
  </p>
  <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {trabajos.map((post) => <BlogCard post={post} />)}
  </div>
  <div class="mt-10 text-center">
    <Button
      href={localizePath("/blog")}
      variant="outline"
      icon="lucide:arrow-right">{copy.moreWorks}</Button
    >
  </div>
</Section>
