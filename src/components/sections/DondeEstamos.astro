---
import { Icon } from "astro-icon/components";
import { getLangFromUrl } from "@i18n/utils";
import { homeCopy } from "@i18n/home";

const copy = homeCopy(getLangFromUrl(Astro.url));
---

<section id="donde-estamos" class="section-padding bg-surface overflow-hidden">
  <div class="container-wide">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
      <!-- Left: Content -->
      <div data-reveal>
        <p
          class="mb-2 text-xs font-semibold uppercase tracking-wider text-accent"
        >
          {copy.locationEyebrow}
        </p>
        <h2
          class="mb-6 text-3xl font-semibold leading-[1.1] tracking-[-0.035em] sm:text-4xl lg:text-5xl"
        >
          {copy.locationTitle}
        </h2>

        <div
          class="prose prose-sm space-y-4 leading-relaxed text-ink-secondary"
        >
          {copy.locationParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="https://www.google.com/maps/dir//Grúas+del+Vallès,+S.A.,+Avinguda+de+Sant+Julià,+64,+66,+08403+Granollers,+Barcelona"
            target="_blank"
            rel="noopener"
            class="btn btn-md border-2 border-accent text-accent hover:bg-accent hover:text-white"
          >
            <Icon name="lucide:map-pin" class="h-4 w-4" />
            {copy.directions}
          </a>
        </div>
      </div>

      <!-- Right: Map -->
      <div
        class="relative aspect-square overflow-hidden rounded-sm bg-surface-alt lg:aspect-auto lg:h-125"
        data-reveal
        data-reveal-delay="1"
      >
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2981.58434311002!2d2.290547177241258!3d41.609536871272!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4b88616f05971%3A0xe5a3c0e359d9c294!2zR3LDunFzIGRlbCBWYWxsw6hzLCBTLkEu!5e0!3m2!1ses!2ses!4v1717758000000!5m2!1ses!2ses"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={copy.mapTitle}
          class="absolute inset-0"></iframe>
      </div>
    </div>
  </div>
</section>
