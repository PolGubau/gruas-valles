---
// Logos de clientes — prueba social para mejorar conversión.
// Los SVG de src/assets/logos se cargan automáticamente; basta con añadir nuevos
// archivos a esa carpeta para que aparezcan aquí.
import type { ImageMetadata } from "astro";
import { getLangFromUrl } from "@i18n/utils";
import { homeCopy } from "@i18n/home";

interface Props {
  /** Fondo de la sección, alineado con el sistema de Section.astro. */
  bg?: "white" | "alt";
  /** Título visible. Si es null, solo se muestra para lectores de pantalla. */
  title?: string;
}

const { bg = "white", title = homeCopy(getLangFromUrl(Astro.url)).clients } =
  Astro.props;
const lang = getLangFromUrl(Astro.url);

const surface = bg === "alt" ? "bg-surface-alt" : "bg-surface";

// Nombres legibles por slug de archivo (para alt e indexación SEO).
const NOMBRES: Record<string, string> = {
  acciona: "Acciona",
  "el-corte-ingles": "El Corte Inglés",
  "elecnor-vector": "Elecnor",
  grifols: "Grifols",
  henkel: "Henkel",
  mango: "Mango",
  mercadona: "Mercadona",
};

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/logos/*.svg",
  { eager: true },
);

const logos = Object.entries(modules)
  .map(([path, mod]) => {
    const file = path.split("/").pop() ?? path;
    const slug = file.replace(/\.svg$/, "");
    return { src: mod.default.src, nombre: NOMBRES[slug] ?? slug };
  })
  .sort((a, b) => a.nombre.localeCompare(b.nombre, "es"));
---

<section
  class={`border-b border-muted/30 py-12 sm:py-16 ${surface}`}
  aria-labelledby="clientes-title"
>
  <div class="container-wide">
    <h2
      id="clientes-title"
      class="mb-8 text-center text-sm font-medium text-ink-secondary sm:mb-10"
      data-reveal
    >
      {title}
    </h2>
    <ul
      class="grid grid-cols-2 items-center gap-x-4 gap-y-4 sm:grid-cols-4 lg:grid-cols-7"
      data-reveal
      data-reveal-delay="1"
    >
      {
        logos.map((logo) => (
          <li class="flex h-16 min-w-0 items-center justify-center px-2">
            <img
              src={logo.src}
              alt={`${lang === "en" ? "Logo of" : "Logo de"} ${logo.nombre}`}
              width="160"
              height="64"
              loading="lazy"
              decoding="async"
              class="h-12 w-full max-w-32 object-contain"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
