---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import craneImage from "../../assets/images/hero-grua-accion-2024-01.avif";
import structuresImage from "../../assets/images/maniobra-jacenas-14tn-01.avif";
import transportImage from "../../assets/images/flota-camion-grua-200tm-01.avif";
import studiesImage from "../../assets/images/operacion-puerto-2020.avif";
import servicios from "../../data/servicios.json";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import { homeCopy } from "@i18n/home";

interface Props {
  /** En la landing (preview) dejamos solo las categorías destacadas en móvil
   *  y enlazamos a /servicios; en la página dedicada se muestra todo. */
  preview?: boolean;
}

const { preview = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = homeCopy(lang);
const localizePath = useTranslatedPath(lang);

const serviceImages: Record<string, ImageMetadata> = {
  "gruas-moviles-autopropulsadas": craneImage,
  "montaje-estructuras-prefabricado": structuresImage,
  "transportes-especiales": transportImage,
};

const iconos: string[] = [
  "lucide:building-2",
  "lucide:truck",
  "lucide:zap",
  "lucide:package",
  "lucide:users",
  "lucide:shield-check",
  "lucide:building",
  "lucide:clock",
  "lucide:map-pin",
];
---

<Section id="servicios" bg="white" title={copy.servicesTitle}>
  <!-- Departamento de estudios · servicio destacado -->
  <a
    href={localizePath("/servicios/ingenieria-de-maniobra")}
    class="group relative mb-4 block overflow-hidden rounded-sm bg-ink text-white transition-colors hover:bg-neutral-900 sm:mb-6"
    data-reveal
  >
    <div class="h-48 overflow-hidden sm:h-64">
      <Image src={studiesImage} alt="" loading="lazy" widths={[480, 768, 1200].filter((width) => width < studiesImage.width)} sizes="(min-width: 1280px) 1200px, 100vw" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transform-none" />
    </div>
    <div class="flex flex-col gap-8 p-6 sm:p-10 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div class="max-w-3xl">
        <p class="eyebrow text-white/80">
          {copy.studies}
        </p>
        <h3
          class:list={["text-2xl font-semibold leading-tight tracking-tight sm:text-3xl", { "mb-4": !preview }]}
        >
          {copy.engineering}
        </h3>
        {!preview && <p class="text-sm leading-relaxed text-muted sm:text-base">{copy.studiesDescription}</p>}
      </div>
      <span class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-white">
        {copy.details}
        <Icon
          name="lucide:move-right"
          class="h-4 w-4 transition-transform group-hover:translate-x-1"
        />
      </span>
    </div>
  </a>

  <!-- Featured Categories -->
  <div class="mb-12 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {
      servicios.categorias
        .filter((cat: any) => cat.slug !== "ingenieria-de-maniobra")
        .map((cat: any) => {
          const translated = copy.categories[cat.slug] ?? cat;
          const image = serviceImages[cat.slug];
          return (
            <a
              href={localizePath(`/servicios/${cat.slug}`)}
              class="group relative flex flex-col overflow-hidden rounded-sm bg-surface-alt transition-colors hover:bg-neutral-100"
            >
              {image && (
                <div class="aspect-[16/10] overflow-hidden">
                  <Image src={image} alt="" loading="lazy" widths={[320, 480, 768].filter((width) => width < image.width)} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transform-none" />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6 sm:p-8">
                <h3 class:list={["text-xl font-semibold leading-tight transition-colors group-hover:text-accent", { "mb-3": !preview }]}>
                  {translated.titulo}
                </h3>
                {!preview && <p class="text-sm leading-relaxed text-ink-secondary">{translated.descripcion}</p>}
                <span class="mt-auto flex items-center gap-2 pt-8 text-sm font-semibold text-accent">
                  {copy.details}{" "}
                  <Icon
                    name="lucide:move-right"
                    class="h-3 w-3 transition-transform group-hover:translate-x-1"
                  />
                </span>
              </div>
            </a>
          );
        })
    }
  </div>

  <!-- En la landing, este bloque secundario se colapsa en móvil (ver /servicios) -->
  <div
    class:list={["mb-8 text-center", { "max-sm:hidden": preview }]}
  >
    <span class="text-[10px] font-bold uppercase tracking-wider text-muted-dark"
      >{copy.otherServices}</span
    >
  </div>

  <!-- Grid de servicios principales -->
  <div
    class:list={[
      "grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3",
      { "max-sm:hidden": preview },
    ]}
    data-reveal
  >
    {
      copy.mainServices.map((servicio: string, i: number) => (
        <div class="flex items-start gap-4">
          <Icon
            name={iconos[i] ?? iconos[0]}
            class="h-6 w-6 shrink-0 text-accent"
            aria-hidden="true"
          />
          <p class="text-sm font-medium leading-snug text-ink">{servicio}</p>
        </div>
      ))
    }
  </div>

  <!-- CTA solo en móvil y solo en la landing: el detalle completo está en /servicios -->
  {
    preview && (
      <div class="mt-10 text-center sm:hidden">
        <Button
          href={localizePath("/servicios")}
          variant="outline"
          size="sm"
          icon="lucide:arrow-right"
        >
          {copy.allServices}
        </Button>
      </div>
    )
  }
</Section>
