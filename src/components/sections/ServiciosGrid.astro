---
import { Icon } from "astro-icon/components";
import servicios from "../../data/servicios.json";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";
import { homeCopy } from "@i18n/home";

interface Props {
  /** En la landing (preview) dejamos solo las categorías destacadas en móvil
   *  y enlazamos a /servicios; en la página dedicada se muestra todo. */
  preview?: boolean;
}

const { preview = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const copy = homeCopy(lang);
const localizePath = useTranslatedPath(lang);

const iconos: string[] = [
  "lucide:building-2",
  "lucide:truck",
  "lucide:zap",
  "lucide:package",
  "lucide:users",
  "lucide:shield-check",
  "lucide:building",
  "lucide:clock",
  "lucide:map-pin",
];
---

<Section id="servicios" bg="white" title={copy.servicesTitle}>
  <!-- Departamento de estudios · servicio destacado -->
  <a
    href={localizePath("/servicios/ingenieria-de-maniobra")}
    class="group relative mb-4 flex flex-col gap-8 overflow-hidden rounded-sm bg-ink p-6 text-white transition-colors hover:bg-neutral-900 sm:mb-6 sm:p-10 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
    data-reveal
  >
    <div class="max-w-3xl">
      <p class="eyebrow text-white/80">
        {copy.studies}
      </p>
      <h3
        class="mb-4 text-2xl font-semibold leading-tight tracking-tight sm:text-3xl"
      >
        {copy.engineering}
      </h3>
      <p class="text-sm leading-relaxed text-muted sm:text-base">
        {copy.studiesDescription}
      </p>
    </div>
    <span
      class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-white"
    >
      {copy.details}
      <Icon
        name="lucide:move-right"
        class="h-4 w-4 transition-transform group-hover:translate-x-1"
      />
    </span>
  </a>

  <!-- Featured Categories -->
  <div class="mb-12 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {
      servicios.categorias
        .filter((cat: any) => cat.slug !== "ingenieria-de-maniobra")
        .map((cat: any) => {
          const translated = copy.categories[cat.slug] ?? cat;
          return (
            <a
              href={localizePath(`/servicios/${cat.slug}`)}
              class="group relative flex flex-col rounded-sm bg-surface-alt p-6 transition-colors hover:bg-neutral-100 sm:p-8"
            >
              <div class="mb-8 flex h-10 w-10 items-center justify-center rounded-sm bg-white text-accent">
                <Icon
                  name="lucide:arrow-up-right"
                  class="h-5 w-5"
                  aria-hidden="true"
                />
              </div>
              <h3 class="mb-3 text-xl font-semibold leading-tight transition-colors group-hover:text-accent">
                {translated.titulo}
              </h3>
              <p class="text-sm leading-relaxed text-ink-secondary">
                {translated.descripcion}
              </p>
              <span class="mt-auto flex items-center gap-2 pt-8 text-sm font-semibold text-accent">
                {copy.details}{" "}
                <Icon
                  name="lucide:move-right"
                  class="h-3 w-3 transition-transform group-hover:translate-x-1"
                />
              </span>
            </a>
          );
        })
    }
  </div>

  <!-- En la landing, este bloque secundario se colapsa en móvil (ver /servicios) -->
  <div
    class:list={["mb-8 flex items-center gap-4", { "max-sm:hidden": preview }]}
  >
    <div class="h-px flex-1 bg-muted"></div>
    <span class="text-[10px] font-bold uppercase tracking-wider text-muted-dark"
      >{copy.otherServices}</span
    >
    <div class="h-px flex-1 bg-muted"></div>
  </div>

  <!-- Grid de servicios principales -->
  <div
    class:list={[
      "grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3",
      { "max-sm:hidden": preview },
    ]}
    data-reveal
  >
    {
      copy.mainServices.map((servicio: string, i: number) => (
        <div class="flex items-start gap-4 border-t border-muted/50 py-5">
          <Icon
            name={iconos[i] ?? iconos[0]}
            class="h-6 w-6 shrink-0 text-accent"
            aria-hidden="true"
          />
          <p class="text-sm font-medium leading-snug text-ink">{servicio}</p>
        </div>
      ))
    }
  </div>

  <!-- CTA solo en móvil y solo en la landing: el detalle completo está en /servicios -->
  {
    preview && (
      <div class="mt-10 text-center sm:hidden">
        <Button
          href={localizePath("/servicios")}
          variant="outline"
          size="sm"
          icon="lucide:arrow-right"
        >
          {copy.allServices}
        </Button>
      </div>
    )
  }
</Section>
