---
import { Icon } from "astro-icon/components";
import contacto from "../../data/contacto.json";
import { catalogo } from "../../lib/docs";
---

<section id="contacto" class="section-padding bg-surface-alt">
  <div class="container-wide">
    <div class="mb-8 max-w-2xl sm:mb-10">
      <p
        class="mb-2 text-xs font-semibold uppercase tracking-wider text-accent"
      >
        Contacto directo
      </p>
      <h2 class="text-3xl font-black sm:text-4xl">Hable con nuestro equipo</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-secondary sm:text-base">
        Contacte directamente con la persona o departamento que necesita. Llame
        o envíe un email con un solo clic.
      </p>
    </div>

    <div class="grid gap-px bg-muted sm:grid-cols-2 xl:grid-cols-3">
      {
        contacto.contactos.map((persona) => (
          <article class="flex min-h-48 flex-col bg-surface p-5 sm:p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent">
              {persona.area}
            </p>
            <h3 class="mt-2 text-xl font-bold text-ink">{persona.nombre}</h3>
            <div class="mt-6 space-y-3 text-sm">
              <a
                href={`tel:+34${persona.telefono.replace(/\s/g, "")}`}
                class="group flex items-center gap-3 font-semibold text-ink transition-colors hover:text-accent"
              >
                <Icon
                  name="lucide:phone"
                  class="h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                <span>{persona.telefono}</span>
              </a>
              <a
                href={`mailto:${persona.email}`}
                class="group flex items-start gap-3 text-ink-secondary transition-colors hover:text-accent"
              >
                <Icon
                  name="lucide:mail"
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                <span class="break-all">{persona.email}</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <aside
      class="mt-8 grid gap-6 bg-ink p-6 text-white sm:p-8 lg:grid-cols-[1.4fr_1fr_auto] lg:items-center"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-accent">
          Oficinas centrales
        </p>
        <p class="mt-2 text-lg font-bold">{contacto.empresa}</p>
        <p class="mt-1 text-sm text-white/75">
          CIF {contacto.cif} · {contacto.direccion}
        </p>
      </div>
      <div class="space-y-2 text-sm">
        <a
          href={`tel:${contacto.telefono.replace(/\s/g, "")}`}
          class="flex items-center gap-2 hover:text-accent"
        >
          <Icon
            name="lucide:phone"
            class="h-4 w-4 shrink-0 text-accent"
            aria-hidden="true"
          />
          {contacto.telefono}
        </a>
        <p class="flex items-center gap-2 text-white/75">
          <Icon
            name="lucide:printer"
            class="h-4 w-4 shrink-0 text-accent"
            aria-hidden="true"
          />
          Fax {contacto.fax}
        </p>
      </div>
      <a
        href={catalogo.url}
        download={catalogo.filename}
        class="inline-flex items-center justify-center gap-2.5 border-2 border-white/20 px-5 py-3 text-sm font-semibold uppercase tracking-wider text-white transition-colors hover:border-accent hover:text-accent"
      >
        <Icon
          name="lucide:download"
          class="h-4 w-4 shrink-0 text-accent"
          aria-hidden="true"
        />
        {catalogo.label}
      </a>
    </aside>
  </div>
</section>
