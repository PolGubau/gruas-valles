---
import { Icon } from "astro-icon/components";
import contacto from "../../data/contacto.json";
import { catalogo } from "../../lib/docs";
import { getLangFromUrl } from "@i18n/utils";
import { homeCopy } from "@i18n/home";
import { es } from "@i18n/home.es";

const copy = homeCopy(getLangFromUrl(Astro.url));
---

<section id="contacto" class="section-padding bg-surface-alt">
  <div class="container-wide">
    <div class="mb-8 max-w-2xl sm:mb-10">
      <h2
        class="text-3xl font-semibold leading-[1.1] tracking-[-0.035em] sm:text-4xl lg:text-5xl"
      >
        {copy.contactTitle}
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-secondary sm:text-base">
        {copy.contactIntro}
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 xl:grid-cols-3">
      {
        contacto.contactos.map((persona) => (
          <article class="flex min-h-48 flex-col rounded-sm bg-surface p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-accent">
              {copy.areas[es.areas.indexOf(persona.area)] ?? persona.area}
            </p>
            <h3 class="mt-2 text-xl font-semibold text-ink">
              {persona.nombre}
            </h3>
            <div class="mt-6 space-y-3 text-sm">
              <a
                href={`tel:+34${persona.telefono.replace(/\s/g, "")}`}
                class="group flex items-center gap-3 font-semibold text-ink transition-colors hover:text-accent"
              >
                <Icon
                  name="lucide:phone"
                  class="h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                <span>{persona.telefono}</span>
              </a>
              <a
                href={`mailto:${persona.email}`}
                class="group flex items-start gap-3 text-ink-secondary transition-colors hover:text-accent"
              >
                <Icon
                  name="lucide:mail"
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                <span class="break-all">{persona.email}</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <aside
      class="mt-6 grid gap-6 rounded-sm bg-ink p-6 text-white sm:p-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_auto] lg:items-center lg:gap-10"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-wider text-accent-light"
        >
          {copy.offices}
        </p>
        <p class="mt-2 text-lg font-semibold">{contacto.empresa}</p>
        <p class="mt-1 text-sm text-white/75">
          CIF {contacto.cif} · {contacto.direccion}
        </p>
      </div>
      <div class="space-y-2 text-sm">
        <a
          href={`tel:${contacto.telefono.replace(/\s/g, "")}`}
          class="flex items-center gap-2 hover:text-accent-light"
        >
          <Icon
            name="lucide:phone"
            class="h-4 w-4 shrink-0 text-accent-light"
            aria-hidden="true"
          />
          {contacto.telefono}
        </a>
        <p class="flex items-center gap-2 text-white/75">
          <Icon
            name="lucide:printer"
            class="h-4 w-4 shrink-0 text-accent-light"
            aria-hidden="true"
          />
          Fax {contacto.fax}
        </p>
      </div>
      <a
        href={catalogo.url}
        download={catalogo.filename}
        class="btn min-h-11 border-2 border-white/20 px-5 py-3 text-sm text-white hover:border-accent-light hover:text-accent-light"
      >
        <Icon
          name="lucide:download"
          class="h-4 w-4 shrink-0 text-accent-light"
          aria-hidden="true"
        />
        {copy.download}
      </a>
    </aside>
  </div>
</section>
