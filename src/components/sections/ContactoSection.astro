---
import { Icon } from "astro-icon/components";
import contacto from "../../data/contacto.json";
import { equipo } from "../../lib/equipo";
import { catalogo } from "../../lib/docs";
import { resolveImage } from "../../lib/images";
import { getLangFromUrl } from "@i18n/utils";
import { homeCopy } from "@i18n/home";

const lang = getLangFromUrl(Astro.url);
const copy = homeCopy(lang);
---

<section id="contacto" class="section-padding bg-surface-alt">
  <div class="container-wide">
    <div class="mb-8 max-w-2xl sm:mb-10">
      <h2
        class="text-3xl font-semibold leading-[1.1] tracking-[-0.035em] sm:text-4xl lg:text-5xl"
      >
        {copy.contactTitle}
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-secondary sm:text-base">
        {copy.contactIntro}
      </p>
    </div>

    <aside
      class="mb-6 grid gap-6 rounded-sm bg-ink p-6 text-white sm:p-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_auto] lg:items-center lg:gap-10"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-wider text-accent-light"
        >
          {copy.offices}
        </p>
        <p class="mt-2 text-lg font-semibold">{contacto.empresa}</p>
        <p class="mt-1 text-sm text-white/75">
          CIF {contacto.cif} · {contacto.direccion}
        </p>
      </div>
      <div class="space-y-2 text-sm">
        <a
          href={`tel:${contacto.telefono.replace(/\s/g, "")}`}
          class="flex items-center gap-2 hover:text-accent-light"
        >
          <Icon
            name="lucide:phone"
            class="h-4 w-4 shrink-0 text-accent-light"
            aria-hidden="true"
          />
          {contacto.telefono}
        </a>
        <a
          href={`mailto:${contacto.email}`}
          class="flex items-center gap-2 hover:text-accent-light"
        >
          <Icon
            name="lucide:mail"
            class="h-4 w-4 shrink-0 text-accent-light"
            aria-hidden="true"
          />
          <span class="break-all">{contacto.email}</span>
        </a>
      </div>
      <a
        href={catalogo.url}
        download={catalogo.filename}
        class="btn min-h-11 border-2 border-white/20 px-5 py-3 text-sm text-white hover:border-accent-light hover:text-accent-light"
      >
        <Icon
          name="lucide:download"
          class="h-4 w-4 shrink-0 text-accent-light"
          aria-hidden="true"
        />
        {copy.download}
      </a>
    </aside>

    <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 xl:grid-cols-3">
      {
        equipo.map((persona) => (
          <article class="flex min-h-28 overflow-hidden bg-surface">
            <div class="w-24 shrink-0 bg-surface-alt sm:w-28">
              <img
                src={persona.foto ? resolveImage(persona.foto) : "/images/equipo-placeholder.svg"}
                alt=""
                class="h-full min-h-28 w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="flex min-w-0 flex-col justify-center p-4 sm:p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-accent">
                {copy.areas[persona.area] ?? persona.area}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-ink">{persona.nombre}</h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
